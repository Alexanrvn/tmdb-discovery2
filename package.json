  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "devmoji": "^2.3.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
